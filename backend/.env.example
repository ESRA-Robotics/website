# Copy to .env.local on the private API host, never public Pages hosting.
# Generate a unique signing secret of at least 32 random characters.
ESRA_SECRET=
ESRA_SITE=http://127.0.0.1:8000
REVIEWER_EMAILS=
EMAIL_DELIVERY=disabled
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Production-only settings (see README):
# ESRA_DB=/var/lib/esra-events/events.sqlite3
# ESRA_ORIGINS=https://esrarobotics.eu
# ESRA_TRUST_PROXY=1
